# LinkeGringo Web Environment Variables (Client-Side)

# Umami Analytics (Optional - Privacy-First, Zero PII)
# Set your Umami website ID to enable anonymous telemetry.
# In GitHub Pages CI/CD, this is passed via repository variable VITE_UMAMI_WEBSITE_ID.
VITE_UMAMI_WEBSITE_ID=

# Umami Script Source (Optional - defaults to https://cloud.umami.is/script.js)
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js
